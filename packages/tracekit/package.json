{
  "name": "@confideleap/tracekit",
  "version": "0.1.0",
  "description": "End-to-end telemetry SDK for Confideleap: request, action, job, and workflow IDs, W3C trace context, structured logs, failure stages, async propagation, and headless Faro integration",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/confideleap/tracekit.git"
  },
  "homepage": "https://github.com/confideleap/tracekit",
  "bugs": {
    "url": "https://github.com/confideleap/tracekit/issues"
  },
  "keywords": [
    "telemetry",
    "observability",
    "request-id",
    "trace-context",
    "opentelemetry",
    "faro",
    "ulid",
    "uuidv7"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "native",
    "README.md"
  ],
  "scripts": {
    "build:native": "bash ../../scripts/build-native.sh",
    "build:ts": "rm -rf dist && tsc -p tsconfig.json",
    "build": "npm run build:ts",
    "test": "npm run build:ts && node --test dist/test/*.test.js",
    "demo": "node examples/local-e2e.js",
    "clean": "rm -rf dist"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    },
    "./apollo": {
      "types": "./dist/apollo.d.ts",
      "default": "./dist/apollo.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "browser": "./dist/web.js",
      "default": "./dist/web.js"
    },
    "./bullmq": {
      "types": "./dist/bullmq.d.ts",
      "default": "./dist/bullmq.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.200.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.200.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "express": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
